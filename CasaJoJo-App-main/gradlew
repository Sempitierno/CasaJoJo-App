#!/bin/sh

#
# Script de arranque de Gradle Wrapper para Linux/macOS (versión simplificada, compatible con POSIX sh).
# Descarga y usa la versión de Gradle indicada en gradle/wrapper/gradle-wrapper.properties.
#

# Resolver APP_HOME siguiendo enlaces simbólicos.
app_path=$0
while [ -h "$app_path" ]; do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
      /*) app_path=$link ;;
      *) app_path=${app_path%"${app_path##*/}"}$link ;;
    esac
done
APP_HOME=$( cd "${app_path%"${app_path##*/}"}." > /dev/null && pwd -P ) || exit

die () {
    echo "$*" >&2
    exit 1
}

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
    die "ERROR: falta el archivo gradle/wrapper/gradle-wrapper.jar.

Este archivo binario no pudo incluirse en el ZIP. Opciones para restaurarlo:
  1) Abrir el proyecto con Android Studio (Open > carpeta CasaJoJo). La sincronizacion de Gradle
     funciona sin este archivo y descarga Gradle 8.9 automaticamente.
  2) Con Gradle 8.9 instalado, ejecutar en esta carpeta:  gradle wrapper --gradle-version 8.9
  3) Copiar gradle-wrapper.jar desde cualquier otro proyecto Android Studio a gradle/wrapper/.
Consulte la seccion 'Gradle Wrapper' del README.md."
fi

# Determinar el comando Java a utilizar.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME apunta a un directorio invalido: $JAVA_HOME

Configure JAVA_HOME con la ubicacion de su instalacion de Java (JDK 17 o superior)."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1 ; then
        die "ERROR: JAVA_HOME no esta definido y no se encontro el comando 'java' en el PATH.

Instale un JDK 17 o superior y configure JAVA_HOME."
    fi
fi

exec "$JAVACMD" -Xmx64m -Xms64m "-Dorg.gradle.appname=gradlew" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
