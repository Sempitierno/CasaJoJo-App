<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ (API 33): permiso en tiempo de ejecución para mostrar notificaciones locales. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La foto se toma con la app de cámara del sistema (intent IMAGE_CAPTURE): no hace falta el permiso CAMERA
         y la app nunca accede a la galería. Si el dispositivo no tiene cámara, la app sigue funcionando. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+: declara que la app necesita ver si existe una app de cámara. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- allowBackup desactivado: la base de datos local contiene nombres y correos de clientes,
         por lo que no se envía a copias de seguridad en la nube (privacidad). -->
    <application
        android:name=".CasaJoJoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CasaJoJo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CasaJoJo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Entrega a la cámara un URI temporal de escritura para guardar la foto en la carpeta privada. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
