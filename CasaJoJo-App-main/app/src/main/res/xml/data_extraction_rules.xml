<?xml version="1.0" encoding="utf-8"?>
<!-- Excluye la base de datos y las preferencias de las copias de seguridad en la nube
     y de la transferencia entre dispositivos (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
